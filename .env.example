# 이 파일을 .env로 복사하여 실제 값을 설정하세요

# OpenAI — https://platform.openai.com/api-keys
# 용도: 에이전트 두뇌 전체 — 의도 라우팅, Function Calling, 답변 생성, 가드레일 판정, RAGAS 평가 judge
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# 금융감독원 「금융상품한눈에」 오픈API
# 용도: 정기예금 상품추천 tool (Tool 1/2, 실데이터)
FINLIFE_API_KEY=
FINLIFE_BASE_URL=https://finlife.fss.or.kr/finlifeapi

# 한국은행 ECOS
# 용도: 환율조회 tool (Tool 2/2, 실데이터)
ECOS_API_KEY=
ECOS_BASE_URL=https://ecos.bok.or.kr/api

LOG_LEVEL=INFO
